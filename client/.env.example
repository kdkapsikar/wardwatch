# Optional build-time settings (read by `npm run build` / the dev server).

# Centre the report-form map on your city (lat,lng) and set the starting zoom.
# VITE_MAP_CENTER=18.5204,73.8567
# VITE_MAP_ZOOM=13

# Only when the API is hosted on a different origin than the web app (e.g. GitHub Pages + Render).
# Leave unset for `npm run dev` and for the single-server setup.
# VITE_API_URL=https://wardwatch-api.onrender.com
# VITE_BASE=/wardwatch/
