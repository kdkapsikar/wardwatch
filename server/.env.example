# Copy to server/.env and adjust.

NODE_ENV=development
PORT=3001

# Postgres connection string. Append ?sslmode=require for managed databases.
DATABASE_URL=postgres://wardwatch:wardwatch@localhost:5432/wardwatch

# Hours a login session stays valid.
SESSION_TTL_HOURS=12

# Number of reverse-proxy hops in front of the app (0 = none). Required behind
# nginx / a load balancer so rate limiting sees the real client IP.
TRUST_PROXY=0

# Add `upgrade-insecure-requests` to the CSP. Defaults to true when NODE_ENV=production;
# set to false only to try a production build over plain HTTP.
# FORCE_HTTPS=true

# Web-app origin(s) allowed to call this API from a browser, comma-separated, no path or trailing slash.
# Needed when the frontend is hosted elsewhere (e.g. GitHub Pages). Leave empty when API and app share an origin.
# CORS_ORIGINS=https://kdkapsikar.github.io

# An open issue older than this many days counts as "overdue" on the admin dashboard.
OVERDUE_DAYS=7

# PLACEHOLDER citizen sign-in code (see server/src/services/otp.js) - every phone number's OTP is this
# one fixed value until an SMS gateway is wired in. Do not treat this as real access control.
# OTP_CODE=1111

# Used only by `npm test` (the test suite TRUNCATES this database - never point it at real data).
# TEST_DATABASE_URL=postgres://wardwatch:wardwatch@localhost:5432/wardwatch_test
