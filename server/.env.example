# Copy to server/.env and adjust.

NODE_ENV=development
PORT=3001

# Postgres connection string. Append ?sslmode=require for managed databases.
DATABASE_URL=postgres://wardwatch:wardwatch@localhost:5432/wardwatch

# Where uploaded photos are stored. Mount a persistent volume here in production.
UPLOAD_DIR=./uploads

# Hours a login session stays valid.
SESSION_TTL_HOURS=12

# Number of reverse-proxy hops in front of the app (0 = none). Required behind
# nginx / a load balancer so rate limiting sees the real client IP.
TRUST_PROXY=0

# Send the session cookie with the Secure flag. Defaults to true when
# NODE_ENV=production; set to false only for plain-HTTP local production tests.
# COOKIE_SECURE=true

# An open issue older than this many days counts as "overdue" on the admin dashboard.
OVERDUE_DAYS=7

# Used only by `npm test` (the test suite TRUNCATES this database - never point it at real data).
# TEST_DATABASE_URL=postgres://wardwatch:wardwatch@localhost:5432/wardwatch_test
